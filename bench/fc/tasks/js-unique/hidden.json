{
  "criteria": [
    {
      "id": "HIDDEN",
      "kind": "probe",
      "text": "Held-out cases never shown to any agent",
      "argv": [
        "node",
        "--input-type=module",
        "-e",
        "import {readFileSync} from 'node:fs';import {unique} from './unique.mjs';console.log(JSON.stringify(unique(...JSON.parse(readFileSync(0,'utf8')))))"
      ],
      "cases": [
        {
          "id": "case1",
          "stdin": "[[3, 1, 3, 2, 1]]",
          "expect_json": [
            3,
            1,
            2
          ]
        },
        {
          "id": "case2",
          "stdin": "[[]]",
          "expect_json": []
        },
        {
          "id": "case3",
          "stdin": "[[\"c\", \"b\", \"a\", \"c\"]]",
          "expect_json": [
            "c",
            "b",
            "a"
          ]
        }
      ]
    }
  ]
}