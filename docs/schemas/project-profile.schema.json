{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cStack private project profile v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))(?!.*[\\\\\\u0000\\r\\n\\t])(?!.*//)(?!.*\\/$).+$"
        },
        {
          "const": "."
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))(?!.*[\\\\\\u0000\\r\\n\\t])(?!.*//)(?!.*\\/$).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "enum": [
              "configuration",
              "lockfile",
              "convention"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "role"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    },
    "runtime": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "node",
            "python"
          ]
        },
        "declared_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "declared_version"
      ],
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "properties": {
        "adapter": {
          "enum": [
            "node-test",
            "pytest",
            "vitest",
            "none"
          ]
        },
        "roots": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))(?!.*[\\\\\\u0000\\r\\n\\t])(?!.*//)(?!.*\\/$).+$"
              },
              {
                "const": "."
              }
            ]
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "expected_tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 10000,
          "uniqueItems": true
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*$"
          },
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "adapter",
        "roots",
        "expected_tests",
        "plugins"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "existing-image",
            "npm-lock",
            "pip-hashes",
            "manual"
          ]
        },
        "image": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lockfiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))(?!.*[\\\\\\u0000\\r\\n\\t])(?!.*//)(?!.*\\/$).+$"
          },
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "required": [
        "mode",
        "image",
        "lockfiles"
      ],
      "additionalProperties": false
    },
    "conventions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))(?!.*[\\\\\\u0000\\r\\n\\t])(?!.*//)(?!.*\\/$).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 8
    },
    "readiness": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "next_action": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "next_action"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    }
  },
  "required": [
    "schema_version",
    "scope",
    "evidence",
    "runtime",
    "test",
    "environment",
    "conventions",
    "readiness",
    "missing"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "test": {
            "properties": {
              "adapter": {
                "not": {
                  "const": "pytest"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "test": {
            "properties": {
              "plugins": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
