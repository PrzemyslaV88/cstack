{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cStack upgrade shared artifacts",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\\\u0000\\r\\n\\t]).+$"
    },
    "accounting": {
      "type": "object",
      "properties": {
        "accounting_complete": {
          "type": "boolean"
        },
        "known_total_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "unknown_attempt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "can_admit": {
          "type": "boolean"
        },
        "diagnostic": {
          "enum": [
            "USAGE_UNRESOLVED",
            null
          ]
        }
      },
      "required": [
        "accounting_complete",
        "known_total_tokens",
        "total_tokens",
        "unknown_attempt_ids",
        "can_admit",
        "diagnostic"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/accounting"
}
